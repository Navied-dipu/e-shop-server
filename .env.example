# Neon (or any PostgreSQL) connection string.
# For Neon, use the DIRECT (non-pooled) URL for migrations and the POOLED URL for the app:
#   DATABASE_URL (pooled, for runtime):  ...-pooler.aws.neon.tech:6543/neondb?sslmode=require&pgbouncer=true
#   DIRECT_DATABASE_URL (for prisma migrate): ...c-3.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/neondb?sslmode=require"
DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/neondb?sslmode=require"
PORT=5000
JWT_SECRET="change-me-in-production"
